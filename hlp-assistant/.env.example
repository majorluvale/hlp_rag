# ---------- Serveur ----------
PORT=3000
# Clé aléatoire longue (ex. : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=change-me
# Emails ayant le rôle admin (accès Observabilité + gestion des rôles), séparés par des virgules
ADMIN_EMAILS=

# ---------- LLM (toute API compatible OpenAI : Groq, OpenAI, Anthropic, Mistral, OpenRouter, Azure, Ollama…) ----------
# Valeurs par défaut : un admin peut les remplacer à chaud dans Observabilité › Paramètres (clé chiffrée en base).
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# Modèle rapide pour l'évaluation automatique (LLM juge)
LLM_FAST_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0.3
AGENT_MAX_STEPS=6
AUTO_EVAL=true

# ---------- Base de données ----------
# Vide = fichier SQLite local (data/hlp.db). Obligatoire sur Vercel : base Turso (https://turso.tech, gratuit)
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# ---------- Embeddings ----------
# local = sur le CPU (gratuit, privé) ; huggingface = API Hugging Face, même modèle e5 (pour Vercel) ; openai = API /embeddings
EMBEDDING_PROVIDER=local
# local : Xenova/multilingual-e5-small ; huggingface : intfloat/multilingual-e5-small (compatibles entre eux)
EMBEDDING_MODEL=
# Jeton Hugging Face (lecture) si EMBEDDING_PROVIDER=huggingface : https://huggingface.co/settings/tokens
HF_TOKEN=

# ---------- Documents ----------
# Dossiers de PDF à indexer, séparés par ;
DOCS_DIRS=data/docs;../../docs;../../knowledge
AUTO_INGEST=true

# ---------- Recherche web (sites de confiance uniquement) ----------
# Global Shelter Cluster (sheltercluster.org) ≠ SLSC : ajoutez le domaine du SLSC quand il aura un site
WEB_DOMAINS=globalprotectioncluster.org,nrc.no,unhabitat.org,cccmcluster.org,sheltercluster.org,reliefweb.int
# Optionnel mais recommandé (1000 recherches/mois gratuites) : https://tavily.com — sinon DuckDuckGo est utilisé
TAVILY_API_KEY=
LEARN_FROM_WEB=true

# ---------- Email OTP (SMTP) ----------
# Ex. Gmail : smtp.gmail.com / 465 / adresse / mot de passe d'application
# Ex. Office 365 : smtp.office365.com / 587 ; Brevo : smtp-relay.brevo.com / 587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=HLP Assistant <no-reply@example.org>
# Sans SMTP, le code s'affiche dans la console du serveur. true = l'afficher aussi dans l'interface (démo uniquement !)
DEV_SHOW_OTP=false

# ---------- Langfuse (optionnel : miroir des traces et scores) ----------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

GUEST_HOURLY_LIMIT=30
